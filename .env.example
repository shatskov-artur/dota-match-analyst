# BFF server
PORT=3001

# Upstash Redis. Only the HOST of this URL is used — cache.ts rebuilds the
# connection as rediss://:<UPSTASH_REDIS_TOKEN>@<host>. Do not append a port:
# Upstash's TLS endpoint answers on the ioredis default (6379), not 6380.
# Either the REST URL or the endpoint hostname works; the scheme is ignored.
# Find at: console.upstash.com → your database → Endpoint / REST URL
UPSTASH_REDIS_URL=https://your-instance.upstash.io
UPSTASH_REDIS_TOKEN=your-token-here

# Valve Web API key — get from https://steamcommunity.com/dev/apikey
VALVE_API_KEY=your-valve-api-key-here

# Stratz API token — get from https://stratz.com/api (env.ts requires it)
STRATZ_TOKEN=your-stratz-token-here

# CORS origin (optional in dev — server falls back to http://localhost:5173).
# In production set this in the Railway dashboard to the exact Vercel URL, no trailing slash.
# CORS_ORIGIN=https://your-app.vercel.app
