# BFF server
PORT=3001

# Upstash Redis — Redis-protocol endpoint (not the REST URL)
# Find at: console.upstash.com → your database → "Redis Connect" → "ioredis" tab
UPSTASH_REDIS_URL=rediss://your-instance.upstash.io:6380
UPSTASH_REDIS_TOKEN=your-token-here

# Valve Web API key — get from https://steamcommunity.com/dev/apikey
VALVE_API_KEY=your-valve-api-key-here
