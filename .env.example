# BFF server
PORT=3001

# Upstash Redis. Only the HOST of this URL is used — cache.ts rebuilds the
# connection as rediss://:<UPSTASH_REDIS_TOKEN>@<host>. Do not append a port:
# Upstash's TLS endpoint answers on the ioredis default (6379), not 6380.
# Either the REST URL or the endpoint hostname works; the scheme is ignored.
# Find at: console.upstash.com → your database → Endpoint / REST URL
UPSTASH_REDIS_URL=https://your-instance.upstash.io
UPSTASH_REDIS_TOKEN=your-token-here

# Valve Web API key — get from https://steamcommunity.com/dev/apikey
VALVE_API_KEY=your-valve-api-key-here

# Stratz API token — get from https://stratz.com/api (env.ts requires it)
STRATZ_TOKEN=your-stratz-token-here

# CORS origin (optional in dev — server falls back to http://localhost:5173).
# In production set this in the Railway dashboard to the exact Vercel URL, no trailing slash.
# REQUIRED when NODE_ENV=production: the localhost fallback would otherwise let a page on
# the visitor's own machine read the API.
# CORS_ORIGIN=https://your-app.vercel.app

# Shared secret guarding /api/* — everything except /api/health.
#
# Optional locally: unset means no check, which is why `npm run dev` needs no setup.
# REQUIRED when NODE_ENV=production, because an anonymous BFF is an open tap on the Valve
# and Stratz quota this key pays for — one /api/live/intel/:id call costs up to ten OpenDota
# and ten Stratz requests against a budget of 500 an hour.
#
# The frontend must send the same value: set VITE_API_TOKEN to it at BUILD time.
# It ships inside the JS bundle, so it is not a secret from someone reading the network tab
# — it stops crawlers and accidental discovery, and the rate limiter caps what one client
# can spend. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# API_TOKEN=

# ─── Script-only variables ──────────────────────────────────────────────────
# Not read by the server; listed here because nothing else documents them.
#
# Port for the embedded Postgres (server/scripts/local-postgres.ts). Use it when 55432 is
# still held by a force-killed instance:  PG_PORT=55433 npm run pg:start --prefix server
# PG_PORT=55432
#
# BFF origin used by scripts/find-league.ts when the server is not on the default port.
# BFF_BASE=http://localhost:3001


# ─── v2.0 tournament archive ────────────────────────────────────────────────

# Postgres holding the per-minute archive. Optional: without it the BFF still serves
# /api/live/*, but NOTHING is recorded and the ingest job refuses to start.
#
# Local, no Docker and no admin rights (npm run pg:start --prefix server):
DATABASE_URL=postgres://dota:dota@localhost:55432/dota_stats
# Local via Docker instead (docker compose -f docker-compose.local.yml up -d):
# DATABASE_URL=postgres://dota:dota@localhost:5432/dota_stats
#
# The database MUST be UTF8. initdb inherits the Windows system locale, and a WIN1250
# database rejects Cyrillic player names outright. Both paths above create it correctly.

# Plain Redis, used INSTEAD of the UPSTASH_* pair when set. docker-compose.local.yml
# ships one; leave unset to keep using Upstash.
# REDIS_URL=redis://localhost:6379

# WHAT GETS RECORDED — two rules, and the first one wins.
#
# 1. TRACKED_LEAGUE_IDS — an explicit, EXCLUSIVE list. Set it and only these leagues are
#    recorded, whatever tier they are. This is also the escape hatch for a tournament that
#    was announced yesterday and is not indexed by OpenDota yet.
#    Resolve an id rather than guessing:  npm run find:league -- --name="The International 2026"
# TRACKED_LEAGUE_IDS=19719
#
# 2. ARCHIVE_LEAGUE_TIERS — used when the list above is empty, which is the default.
#    Records by the CALIBRE of the tournament, using OpenDota's own tier names:
#      premium       The International, Majors                     (tier 1)
#      professional  the tier 2-3 circuit                           (tier 2-3)
#      amateur       ladders, open qualifiers, community cups       (NOT recorded by default)
#      excluded      leagues OpenDota filters out entirely
#    Default is "premium,professional". Recording amateur as well is what used to fill the
#    disk at roughly a gigabyte a day with games nobody would ever open — a single match is
#    ~3 MB of per-minute snapshots, and a quiet evening carries twenty of them at once.
#    A league whose tier cannot be resolved is NOT recorded; name it above if you want it.
# ARCHIVE_LEAGUE_TIERS=premium,professional

# Kill switch for the background recorder. HISTORY_SAMPLER_DISABLED is the older name and
# is honoured identically; both go through the zod schema in server/src/env.ts, so a typo in
# either is now caught at boot instead of silently doing nothing.
# INGEST_DISABLED=1
# HISTORY_SAMPLER_DISABLED=1
