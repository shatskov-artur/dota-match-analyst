# ─────────────────────────────────────────────────────────────────────────────
# PRODUCTION ENV TEMPLATE — split-origin deploy (Railway BFF + Vercel SPA)
#
# NOTHING here is committed with real values. Set these ONLY in the provider
# dashboards (Railway / Vercel). This file documents WHAT to set and WHERE.
# ─────────────────────────────────────────────────────────────────────────────

# ── BFF (set in Railway → project → Service → Variables) ─────────────────────
# Railway injects PORT automatically — do NOT set PORT yourself.

NODE_ENV=production

# Upstash Redis — from the Upstash console → your database.
# Only the HOST of this URL is used: cache.ts rebuilds the connection as
# rediss://:<UPSTASH_REDIS_TOKEN>@<host>. Do NOT append a port — Upstash's TLS
# endpoint answers on ioredis's default 6379, and a ":6380" URL will not connect.
UPSTASH_REDIS_URL=https://your-instance.upstash.io
UPSTASH_REDIS_TOKEN=your-upstash-token-here

# Upstream API credentials
VALVE_API_KEY=your-valve-api-key-here          # https://steamcommunity.com/dev/apikey
STRATZ_TOKEN=your-stratz-token-here            # https://stratz.com/api

# CORS: the EXACT Vercel production origin — no trailing slash, no path.
# e.g. https://your-app.vercel.app  (NOT https://your-app.vercel.app/)
# REQUIRED: the server refuses to boot without it under NODE_ENV=production, because the
# dev fallback (http://localhost:5173) would let a page on a visitor's own machine read
# this API.
CORS_ORIGIN=https://your-app.vercel.app

# Shared secret guarding /api/* (everything except /api/health).
# REQUIRED: without it the BFF is anonymous, and every request spends the Valve and Stratz
# quota these keys pay for. Must equal VITE_API_TOKEN below.
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
API_TOKEN=generate-a-long-random-string

# ── v2.0 tournament archive (Railway) ───────────────────────────────────────
# Add a Postgres service in Railway and reference its connection string. WITHOUT this the
# BFF still serves /api/live/*, but every tournament, bracket, schedule and time-travel
# route answers empty — while /api/health stays green. `archive` in the health body says
# which of the three states you are in: reachable / unreachable / not_configured.
#
# Migrations run automatically: railway.json's startCommand is
#   npm run migrate:deploy && npm run start:server
# and migrate:deploy is a no-op when DATABASE_URL is unset.
# DATABASE_URL=${{Postgres.DATABASE_URL}}

# Which tournaments get recorded. Leave both unset to record premium + professional tiers.
# Resolve an id rather than guessing: npm run find:league -- --name="The International 2026"
# TRACKED_LEAGUE_IDS=19719
# ARCHIVE_LEAGUE_TIERS=premium,professional

# Kill switch for the background recorder, if the deploy should serve reads only.
# INGEST_DISABLED=1

# ── Frontend (set in Vercel → project → Settings → Environment Variables) ────
# VITE_* is inlined at BUILD time by Vite — it MUST be set BEFORE the Vercel
# build runs, and it lives in the client bundle (it is a public URL, not a secret).
# The Railway BFF public origin — no trailing slash, no /api suffix.
# e.g. https://your-bff.up.railway.app  (call-sites append /api/... themselves)
VITE_API_URL=https://your-bff.up.railway.app

# Must equal API_TOKEN above. Inlined into the bundle like every VITE_* value, so treat it
# as public: it stops crawlers and accidental discovery, not a determined reader.
VITE_API_TOKEN=the-same-value-as-API_TOKEN
