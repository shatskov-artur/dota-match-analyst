# Build config for the static snapshot demo — NOT a secret, committed on purpose.
# Consumed by `vite build --mode demo` (see client/package.json → build:demo).
#
# With this set, the client answers every /api/* request from the captured JSON in
# demo-data/ and makes no network calls at all. See client/src/lib/apiFetch.ts.
VITE_DEMO_MODE=1

# Deliberately empty: nothing in a demo build may point at a backend origin.
VITE_API_URL=
